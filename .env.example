# ReviewLens Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# None of these keys are required for offline or benchmark demo testing.
# When keys are absent, ReviewLens automatically uses verified benchmark archives and OpenStreetMap fallback.

HOST=0.0.0.0
PORT=8000
REVIEWLENS_DEMO_MODE=false

# 1. Reddit API (Official OAuth Credentials from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ReviewLens/1.0 (evidence-analysis)

# 2. Google Places & Maps Platform (From Google Cloud Console)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# 3. Permitted Web Search API (SearXNG / Custom endpoint)
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=

# 4. Resilience & Cache TTL
CACHE_TTL_SECONDS=3600
